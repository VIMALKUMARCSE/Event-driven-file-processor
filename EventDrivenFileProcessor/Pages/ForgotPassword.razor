@page "/forgot-password"
@using EventDrivenFileProcessor.Services
@inject CognitoAuthService AuthService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.False" Class="d-flex justify-center align-center pa-0"
              Style="min-height: 100vh; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">

    <MudPaper Class="pa-8" Elevation="6" Style="border-radius: 16px; max-width: 420px; width: 100%; margin: 16px;">

        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Color="Color.Default"
                           OnClick="GoBack" />
        </MudStack>

        <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="mb-6">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Primary" Style="font-size: 3rem;" />
            <MudText Typo="Typo.h5" Align="Align.Center">Forgot Password</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                Enter your email and we'll send you a verification code
            </MudText>
        </MudStack>

        <MudStack Spacing="4">
            <MudTextField Label="Email"
                          Variant="Variant.Outlined"
                          @bind-Value="Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          FullWidth="true" />

            @if (!string.IsNullOrEmpty(Message))
            {
                <MudAlert Severity="@MessageSeverity" Class="mt-2" Dense="true">
                    @Message
                </MudAlert>
            }

            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Size="Size.Large"
                       OnClick="SendCode">
                Send Code
            </MudButton>

            @if (ShowResetForm)
            {
                <MudDivider Class="my-2" />

                <MudTextField Label="Verification Code"
                              Variant="Variant.Outlined"
                              @bind-Value="VerificationCode"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Pin"
                              FullWidth="true" />

                <MudTextField Label="New Password"
                              Variant="Variant.Outlined"
                              @bind-Value="NewPassword"
                              InputType="@(_showPassword? InputType.Text: InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="TogglePasswordVisibility"
                              AdornmentColor="Color.Secondary"
                              FullWidth="true" />

                @if (!string.IsNullOrEmpty(Messagetwo))
                {
                    <MudAlert Severity="@MessageSeverity" Class="mt-2" Dense="true">
                        @Messagetwo
                    </MudAlert>
                }

                <MudButton Color="Color.Success"
                           Variant="Variant.Filled"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="ResetPassword">
                    Reset Password
                </MudButton>
            }
        </MudStack>

    </MudPaper>
</MudContainer>

@code {

    private string Email = "";
    private bool ShowResetForm;
    private string VerificationCode = "";
    private string NewPassword = "";
    private bool _showPassword;
    private string Message = "";
    private string Messagetwo = "";
    private Severity MessageSeverity = Severity.Info;

    private async Task SendCode()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(Email))
            {
                Message = "Email are required";
                return;
            }

            await AuthService
                .ForgotPasswordAsync(Email);

            ShowResetForm = true;

            Snackbar.Add(
                "Verification code sent to email",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
    }

    private async Task ResetPassword()
    {
        try
        {

            if (string.IsNullOrWhiteSpace(VerificationCode) ||
    string.IsNullOrWhiteSpace(NewPassword))
            {
                Messagetwo = "Verification Code and Password are required";
                return;
            }

            await AuthService
                .ConfirmForgotPasswordAsync(
                    Email,
                    VerificationCode,
                    NewPassword);

            Snackbar.Add(
                "Password reset successful",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("login"); // change to your actual login/previous route
    }
}